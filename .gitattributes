# Terminazioni di riga coerenti tra Windows, macOS e Linux.
* text=auto eol=lf

# Script Windows: CRLF nella copia di lavoro.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# File binari.
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.zip binary
*.exe binary
*.dll binary
*.dmg binary
*.AppImage binary
